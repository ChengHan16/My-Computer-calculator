<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>活動紀實 - 立法院系統整合</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <link id="dynamic-theme-css" rel="stylesheet" href="./css/style.css">

    <style>
        /* --- 專業檔案外框與清單風格 --- */
        .event-content-area {
            max-width: 1100px;
            margin: 0 auto;
            width: 95%;
            padding: 40px 0;
        }

        .year-group-title {
            font-size: 1.5rem;
            color: var(--ly-blue);
            font-weight: bold;
            margin: 40px 0 20px;
            padding-left: 15px;
            border-left: 5px solid var(--ly-gold);
            display: flex;
            align-items: center;
            background: linear-gradient(90deg, rgba(0,49,83,0.05) 0%, transparent 100%);
            height: 45px;
        }

        .doc-list-item {
            background: white;
            border: 1px solid #e0e0e0;
            border-left: 6px solid var(--ly-blue);
            margin-bottom: 20px;
            padding: 22px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        .doc-list-item:hover {
            transform: translateX(8px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border-color: var(--ly-gold);
        }

        .doc-info h4 {
            margin: 0 0 10px 0;
            color: var(--ly-blue);
            font-size: 1.3rem;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .doc-info p {
            margin: 0;
            color: #666;
            font-size: 0.95rem;
        }

        .doc-action-hint {
            color: var(--ly-gold);
            font-weight: 900;
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        /* --- 文件預覽風格彈窗 CSS --- */
        .doc-modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0; top: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            justify-content: center;
            align-items: flex-start;
            padding-top: 50px;
            overflow-y: auto;
        }

        .doc-paper {
            background: #fff;
            width: 90%;
            max-width: 850px;
            margin-bottom: 50px;
            padding: 60px 50px;
            box-shadow: 0 0 50px rgba(0,0,0,0.5);
            position: relative;
            border: 1px solid #ddd;
            background-image: radial-gradient(#f0f0f0 1.5px, transparent 1.5px);
            background-size: 30px 30px;
        }

        .doc-header {
            text-align: center;
            border-bottom: 2px double var(--ly-blue);
            padding-bottom: 25px;
            margin-bottom: 40px;
        }

        .doc-watermark {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 6rem;
            color: rgba(0, 49, 83, 0.03);
            pointer-events: none;
            white-space: nowrap;
            font-weight: 900;
        }

        .doc-sub-title {
            color: var(--ly-blue);
            border-left: 5px solid var(--ly-gold);
            padding-left: 15px;
            margin: 35px 0 20px;
            font-size: 1.2rem;
            font-weight: bold;
        }

        /* 投票區與按鈕 */
        .vote-panel {
            background: #fdfaf0;
            padding: 30px;
            border-radius: 10px;
            border: 1px dashed var(--ly-gold);
            text-align: center;
            margin-top: 40px;
        }

        .btn-vote {
            padding: 12px 35px;
            margin: 10px;
            border-radius: 50px;
            border: none;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn-join { background: var(--ly-blue); color: white; }
        .btn-next { background: #777; color: white; }
        .btn-join:hover { background: var(--ly-gold); transform: translateY(-3px); }

        .voter-grid { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px; min-height: 80px; justify-content: center;}
        .voter-box { text-align: center; width: 75px; }
        .voter-box img { width: 60px; height: 60px; border-radius: 50%; border: 2px solid var(--ly-gold); object-fit: cover; background: #eee;}
        .voter-box span { display: block; font-size: 0.8rem; margin-top: 8px; font-weight: bold; color: #444; }

        .doc-close-btn {
            position: absolute;
            right: 25px; top: 25px;
            font-size: 2rem;
            cursor: pointer;
            color: #999;
            background: none; border: none;
            z-index: 10;
        }
    </style>
</head>
<body>

    <div id="header-layout"></div>

    <div class="event-content-area">
        <h2 class="section-title">活動辦理紀實</h2>
        <div id="public-event-display"></div>
    </div>

    <div id="doc-preview-modal" class="doc-modal">
        <article class="doc-paper">
            <button class="doc-close-btn" onclick="closeDocPreview()">&times;</button>
            <div class="doc-watermark">活動檔案存查</div>
            
            <header class="doc-header">
                <h1 id="doc-title" style="color: var(--ly-blue); margin-bottom: 10px;">--</h1>
                <div style="font-size: 0.9rem; color: #666;">
                    檔案編號：<span id="doc-id">--</span> | 存檔日期：<span id="doc-date">--</span>
                </div>
            </header>

            <section id="doc-content" style="line-height: 1.8; color: #333;"></section>

            <section id="vote-area" class="vote-panel" style="display: none;">
                <h3 class="doc-sub-title">出席狀況調查</h3>
                <div class="vote-actions">
                    <button class="btn-vote btn-join" onclick="handleVote('join')">
                        <i class="fas fa-check-circle"></i> 參與
                    </button>
                    <button class="btn-vote btn-next" onclick="handleVote('next')">
                        <i class="fas fa-times-circle"></i> 下次再聚
                    </button>
                </div>
            </section>

            <section>
                <h3 class="doc-sub-title">參與成員名單</h3>
                <div id="voter-list" class="voter-grid"></div>
            </section>
        </article>
    </div>

    <div id="footer-layout"></div>

    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="./js/dashboard.js"></script>

    <script>

// 在 event-documentation.html 內的 script 標籤最上方定義一次即可
const firebaseConfig = { 
    apiKey: "AIzaSyACnoimIASfb1rb59SbgLDkUmyYR6ODbUU",
    authDomain: "llwb-ed686.firebaseapp.com",
    projectId: "llwb-ed686",
    storageBucket: "llwb-ed686.firebasestorage.app", 
    messagingSenderId: "940345852074",
    appId: "1:940345852074:web:7a30cca5a6d997a92350d3",
    measurementId: "G-KWL4ZE3D18"
};

// 初始化 Firebase
if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.firestore();
let currentEventId = null;
document.addEventListener("DOMContentLoaded", () => {
    const themeLink = document.getElementById('dynamic-theme-css');

    auth.onAuthStateChanged(async (user) => {
        // 根據登入狀態切換 CSS
        themeLink.href = user ? "./css/authenticated.css" : "./css/style.css";
        
        // 動態加載腳本
        const scriptPath = user ? "./js/dashboard.js" : "./js/main.js";
        
        // 檢查是否已存在該腳本，避免重複載入導致變數衝突
        if (!document.querySelector(`script[src="${scriptPath}"]`)) {
            const script = document.createElement('script');
            script.src = scriptPath;
            script.onload = async () => {
                // 初始化版面載入
                if (typeof loadLayout === "function") await loadLayout('events');
                
                if (user && typeof syncMemberData === "function") {
                    await syncMemberData("班長", '院內活動籌辦', '立法活動辦理');
                }
                
                // 啟動活動列表監聽
                startPublicEventListen();
            };
            document.body.appendChild(script);
        }
    });
});

// 輔助函式：動態載入 Script 並執行 Callback
function loadDynamicScript(src, callback) {
    // 檢查是否已存在相同的 script 標籤，避免重複載入
    const existingScript = document.querySelector(`script[src="${src}"]`);
    if (existingScript) {
        callback();
        return;
    }

    const script = document.createElement('script');
    script.src = src;
    script.onload = callback;
    document.body.appendChild(script);
}

// 1. 抓取資料並渲染專業檔案清單 (保持不變)
function startPublicEventListen() {
    const display = document.getElementById('public-event-display');
    db.collection("events").onSnapshot(snapshot => {
        display.innerHTML = "";
        let eventsArray = [];
        
        snapshot.forEach(doc => {
            const ev = doc.data();
            const id = doc.id;
            const timeField = ev.fields ? ev.fields.find(f => f.type === 'time') : null;
            let sortDate = timeField ? new Date(timeField.content) : (ev.createdAt ? ev.createdAt.toDate() : new Date());
            eventsArray.push({ id, ...ev, sortDate });
        });

        eventsArray.sort((a, b) => b.sortDate - a.sortDate);

        let currentYear = null;
        eventsArray.forEach(ev => {
            const year = ev.sortDate.getFullYear();
            if (year !== currentYear) {
                currentYear = year;
                display.insertAdjacentHTML('beforeend', `<div class="year-group-title">${year} 年度活動紀實</div>`);
            }

            const itemHtml = `
                <div class="doc-list-item" onclick="openDocPreview('${ev.id}')">
                    <div class="doc-info">
                        <h4>${ev.title}</h4>
                        <p><i class="far fa-clock"></i> ${ev.sortDate.toLocaleString('zh-TW', { hour12: false }).replace(/\//g, '-')}</p>
                    </div>
                    <div class="doc-action-hint">詳情檔案 <i class="fas fa-file-export"></i></div>
                </div>`;
            display.insertAdjacentHTML('beforeend', itemHtml);
        });
    });
}

// 2. 開啟檔案預覽 (移除內部重複的 onAuthStateChanged，由上方全域控管)
async function openDocPreview(id) {
    currentEventId = id;
    const doc = await db.collection("events").doc(id).get();
    const ev = doc.data();

    document.getElementById('doc-title').innerText = ev.title;
    document.getElementById('doc-id').innerText = id.substring(0, 8).toUpperCase();
    document.getElementById('doc-date').innerText = ev.formattedDate || '--';

    const contentArea = document.getElementById('doc-content');
    contentArea.innerHTML = "";

    if (ev.fields) {
        ev.fields.forEach(f => {
            if (f.content === ev.title) return; // 標題去重
            if (f.type === 'image_upload' && f.content) {
                contentArea.innerHTML += `<div style="text-align:center; margin:20px 0;"><img src="${f.content}" style="max-width:100%; border-radius:8px; border:1px solid #eee;"></div>`;
            } else {
                contentArea.innerHTML += `
                    <div style="margin-bottom:15px; border-bottom:1px solid #f9f9f9; padding-bottom:10px;">
                        <strong style="color:var(--ly-blue);">[ ${f.label} ]</strong>
                        <div style="padding-left:15px; margin-top:5px;">${f.content.replace('T', ' ')}</div>
                    </div>`;
            }
        });
    }

    loadVotes(id);
    document.getElementById('doc-preview-modal').style.display = 'flex';
}

function closeDocPreview() {
    document.getElementById('doc-preview-modal').style.display = 'none';
}

// 3. 投票邏輯與參與成員載入 (保持不變)
async function handleVote(choice) {
    const user = auth.currentUser;
    if (!user) return;
    try {
        const userDoc = await db.collection("act").doc(user.uid).get();
        const userData = userDoc.data() || {};
        await db.collection("events").doc(currentEventId).collection("votes").doc(user.uid).set({
            name: userData.displayName || user.email.split('@')[0],
            photo: userData.photoURL || "",
            choice: choice,
            timestamp: firebase.firestore.FieldValue.serverTimestamp()
        });
        alert(choice === 'join' ? "已加入參與名單！" : "感謝您的回饋。");
        loadVotes(currentEventId);
    } catch (error) {
        console.error("投票失敗:", error);
    }
}

function loadVotes(eventId) {
    const list = document.getElementById('voter-list');
    db.collection("events").doc(eventId).collection("votes")
      .where("choice", "==", "join")
      .onSnapshot(snapshot => {
        list.innerHTML = "";
        if (snapshot.empty) {
            list.innerHTML = "<p style='color:#ccc; font-size:0.9rem;'>尚無成員投票...</p>";
            return;
        }
        snapshot.forEach(doc => {
            const v = doc.data();
            list.innerHTML += `
                <div class="voter-box">
                    <img src="${v.photo || 'https://via.placeholder.com/60'}" onerror="this.src='https://via.placeholder.com/60'">
                    <span>${v.name}</span>
                </div>`;
        });
    });
}

// 選單開關功能
        window.toggleNav = function() {
            const sidebar = document.getElementById("mySidebar");
            const overlay = document.getElementById("overlay");
            if (sidebar.style.width === "250px") {
                sidebar.style.width = "0";
                overlay.style.display = "none";
            } else {
                sidebar.style.width = "250px";
                overlay.style.display = "block";
            }
        };
        // 確保已取得 auth 實例
        function confirmLogout() {
            if (confirm("確定登出系統？")) {
                auth.signOut()
                    .then(() => {
                        alert("已成功登出");
                        window.location.href = "login.html"; // 登出後跳轉至登入頁
                    })
                    .catch((error) => {
                        console.error("登出發生錯誤:", error);
                        alert("登出失敗，請稍後再試");
                    });
            }
        }
        function confirmLogout() { if (confirm("確定登出系統？")) auth.signOut().then(() => window.location.href = "login.html"); }
    
    </script>
</body>
</html>
